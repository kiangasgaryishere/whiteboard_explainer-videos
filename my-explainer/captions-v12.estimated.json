  "groups": [
    {
      "start": 0.5,
      "end": 1.143718,
      "text": "تو هم وقتی"
    },
    {
      "start": 1.143718,
      "end": 1.837865,
      "text": "یه لغت جدید"
    },
    {
      "start": 1.837865,
      "end": 2.813612,
      "text": "انگلیسی یاد می‌گیری،"
    },
    {
      "start": 2.813612,
      "end": 3.680589,
      "text": "این سه تا"
    },
    {
      "start": 3.680589,
      "end": 4.097212,
      "text": "کار رو"
    },
    {
      "start": 4.097212,
      "end": 4.692018,
      "text": "انجام می‌دی؟"
    },
    {
      "start": 5.395034,
      "end": 6.31642,
      "text": "معنی فارسیش رو"
    },
    {
      "start": 6.31642,
      "end": 7.378617,
      "text": "توی دفترت می‌نویسی؟"
    },
    {
      "start": 8.017234,
      "end": 9.017692,
      "text": "تعریف انگلیسیش رو"
    },
    {
      "start": 9.017692,
      "end": 10.022812,
      "text": "از دیکشنری می‌خونی؟"
    },
    {
      "start": 10.570249,
      "end": 11.526337,
      "text": "مثال دیکشنری رو"
    },
    {
      "start": 11.526337,
      "end": 12.089911,
      "text": "هم کنارش"
    },
    {
      "start": 12.089911,
      "end": 12.884558,
      "text": "یادداشت می‌کنی؟"
    },
    {
      "start": 13.511179,
      "end": 14.45559,
      "text": "این کارها برای"
    },
    {
      "start": 14.45559,
      "end": 15.263768,
      "text": "شناختن معنی کلمه"
    },
    {
      "start": 15.263768,
      "end": 15.880919,
      "text": "خوبن، اما یه"
    },
    {
      "start": 15.880919,
      "end": 16.374399,
      "text": "مشکل دارن!"
    },
    {
      "start": 16.879048,
      "end": 17.922289,
      "text": "ممکنه معنی یه"
    },
    {
      "start": 17.922289,
      "end": 19.439066,
      "text": "کلمه رو بدونی،"
    },
    {
      "start": 19.439066,
      "end": 20.902709,
      "text": "ولی وقتی می‌خوای"
    },
    {
      "start": 20.902709,
      "end": 22.196052,
      "text": "صحبت کنی، نتونی"
    },
    {
      "start": 22.196052,
      "end": 23.343107,
      "text": "ازش استفاده کنی."
    },
    {
      "start": 23.829478,
      "end": 24.586148,
      "text": "به این می‌گن"
    },
    {
      "start": 24.586148,
      "end": 25.533605,
      "text": "Passive Vocabulary."
    },
    {
      "start": 25.917143,
      "end": 26.97473,
      "text": "یعنی کلمه‌هایی که"
    },
    {
      "start": 26.97473,
      "end": 28.041163,
      "text": "معنی‌شون رو متوجه"
    },
    {
      "start": 28.041163,
      "end": 29.120402,
      "text": "می‌شی، اما نمی‌تونی"
    },
    {
      "start": 29.120402,
      "end": 30.139121,
      "text": "به‌راحتی خودت به"
    },
    {
      "start": 30.139121,
      "end": 31.281444,
      "text": "یادشون بیاری و"
    },
    {
      "start": 31.281444,
      "end": 32.138821,
      "text": "استفاده‌شون کنی."
    },
    {
      "start": 32.564898,
      "end": 33.721071,
      "text": "در مقابل، Active"
    },
    {
      "start": 33.721071,
      "end": 34.854717,
      "text": "Vocabulary قرار داره."
    },
    {
      "start": 35.246259,
      "end": 36.256375,
      "text": "یعنی کلمه‌هایی که"
    },
    {
      "start": 36.256375,
      "end": 37.335468,
      "text": "می‌تونی توی مکالمه"
    },
    {
      "start": 37.335468,
      "end": 38.243313,
      "text": "و نوشتنت ازشون"
    },
    {
      "start": 38.243313,
      "end": 38.956009,
      "text": "استفاده کنی."
    },
    {
      "start": 39.368685,
      "end": 40.455963,
      "text": "حالا چطور کلمه‌ها"
    },
    {
      "start": 40.455963,
      "end": 41.430296,
      "text": "رو وارد دایره‌ی"
    },
    {
      "start": 41.430296,
      "end": 42.094196,
      "text": "لغات فعال"
    },
    {
      "start": 42.094196,
      "end": 42.849524,
      "text": "خودمون کنیم؟"
    },
    {
      "start": 43.279773,
      "end": 43.921135,
      "text": "سه تا مرحله"
    },
    {
      "start": 43.921135,
      "end": 44.596916,
      "text": "رو امتحان کن:"
    },
    {
      "start": 45.066961,
      "end": 46.79068,
      "text": "STEP ONE: CONTEXT."
    },
    {
      "start": 47.21483,
      "end": 48.100221,
      "text": "کلمه رو داخل"
    },
    {
      "start": 48.100221,
      "end": 49.124986,
      "text": "یه موقعیت واقعی"
    },
    {
      "start": 49.124986,
      "end": 49.737982,
      "text": "یاد بگیر."
    },
    {
      "start": 50.070023,
      "end": 50.80439,
      "text": "مثلاً فرض کن"
    },
    {
      "start": 50.80439,
      "end": 51.80964,
      "text": "توی رستورانی و"
    },
    {
      "start": 51.80964,
      "end": 52.752285,
      "text": "می‌خوای از گارسون"
    },
    {
      "start": 52.752285,
      "end": 53.498707,
      "text": "پیشنهاد بگیری."
    },
    {
      "start": 53.898549,
      "end": 54.960019,
      "text": "RECOMMEND یعنی"
    },
    {
      "start": 54.960019,
      "end": 55.929478,
      "text": "پیشنهاد دادن."
    },
    {
      "start": 56.370816,
      "end": 57.83195,
      "text": "STEP TWO: LISTEN."
    },
    {
      "start": 58.294853,
      "end": 59.311561,
      "text": "تلفظ و کاربردش"
    },
    {
      "start": 59.311561,
      "end": 60.086739,
      "text": "رو توی یه"
    },
    {
      "start": 60.086739,
      "end": 60.804172,
      "text": "جمله بشنو:"
    },
    {
      "start": 61.265714,
      "end": 62.035162,
      "text": "Can you recommend"
    },
    {
      "start": 62.035162,
      "end": 62.368844,
      "text": "a dish?"
    },
    {
      "start": 62.805828,
      "end": 64.426077,
      "text": "STEP THREE: USE."
    },
    {
      "start": 64.838503,
      "end": 65.376114,
      "text": "حالا خودت"
    },
    {
      "start": 65.376114,
      "end": 65.871111,
      "text": "جواب بده:"
    },
    {
      "start": 66.252154,
      "end": 66.843302,
      "text": "I'd recommend"
    },
    {
      "start": 66.843302,
      "end": 67.35644,
      "text": "the pasta."
    },
    {
      "start": 67.719841,
      "end": 68.028352,
      "text": "دیدی؟"
    },
    {
      "start": 68.028352,
      "end": 69.124818,
      "text": "حالا می‌تونی از"
    },
    {
      "start": 69.124818,
      "end": 69.952533,
      "text": "این کلمه توی"
    },
    {
      "start": 69.952533,
      "end": 70.940396,
      "text": "یه مکالمه‌ی واقعی"
    },
    {
      "start": 70.940396,
      "end": 71.63161,
      "text": "استفاده کنی!"
    },
    {
      "start": 72.033107,
      "end": 72.995432,
      "text": "برای همین ما"
    },
    {
      "start": 72.995432,
      "end": 74.161392,
      "text": "توی رهنما هر"
    },
    {
      "start": 74.161392,
      "end": 75.066358,
      "text": "هفته ۱۰ لغت"
    },
    {
      "start": 75.066358,
      "end": 76.317418,
      "text": "کاربردی درباره‌ی یک"
    },
    {
      "start": 76.317418,
      "end": 77.250358,
      "text": "موضوع مشخص و"
    },
    {
      "start": 77.250358,
      "end": 78.254975,
      "text": "متناسب با سطح"
    },
    {
      "start": 78.254975,
      "end": 79.543723,
      "text": "زبانت آماده می‌کنیم؛"
    },
    {
      "start": 79.543723,
      "end": 81.13178,
      "text": "همراه با مثال،"
    },
    {
      "start": 81.13178,
      "end": 82.250028,
      "text": "فایل صوتی و"
    },
    {
      "start": 82.250028,
      "end": 83.125132,
      "text": "ورک‌شیت تمرین"
    },
    {
      "start": 83.125132,
      "end": 83.83102,
      "text": "و اسپیکینگ."
    },
    {
      "start": 84.23,
      "end": 85.319634,
      "text": "اگه می‌خوای بسته‌ی"
    },
    {
      "start": 85.319634,
      "end": 86.707198,
      "text": "هفتگی ACTIVE VOCABULARY"
    },
    {
      "start": 86.707198,
      "end": 87.63523,
      "text": "رو دریافت کنی،"
    },
    {
      "start": 87.63523,
      "end": 88.724864,
      "text": "فقط کلمه‌ی ACTIVE"
    },
    {
      "start": 88.724864,
      "end": 89.547991,
      "text": "رو کامنت کن"
    },
    {
      "start": 89.547991,
      "end": 90.570317,
      "text": "تا برات بفرستیم!"
    },
    {
      "start": 90.985397,
      "end": 91.565424,
      "text": "Don't just"
    },
    {
      "start": 91.565424,
      "end": 92.336565,
      "text": "memorize words."
    },
    {
      "start": 92.336565,
      "end": 93.054407,
      "text": "Learn to"
    },
    {
      "start": 93.054407,
      "end": 93.588458,
      "text": "use them!"
    }
  ]
}