  "line_anchors": [
    {
      "start": 0,
      "end": 4.192018,
      "text": "تو هم وقتی یه لغت جدید انگلیسی یاد می‌گیری، این سه تا کار رو انجام می‌دی؟"
    },
    {
      "start": 4.895034,
      "end": 6.878617,
      "text": "معنی فارسیش رو توی دفترت می‌نویسی؟"
    },
    {
      "start": 7.517234,
      "end": 9.522812,
      "text": "تعریف انگلیسیش رو از دیکشنری می‌خونی؟"
    },
    {
      "start": 10.070249,
      "end": 12.384558,
      "text": "مثال دیکشنری رو هم کنارش یادداشت می‌کنی؟"
    },
    {
      "start": 13.011179,
      "end": 15.874399,
      "text": "این کارها برای شناختن معنی کلمه خوبن، اما یه مشکل دارن!"
    },
    {
      "start": 16.379048,
      "end": 22.843107,
      "text": "ممکنه معنی یه کلمه رو بدونی، ولی وقتی می‌خوای صحبت کنی، نتونی ازش استفاده کنی."
    },
    {
      "start": 23.329478,
      "end": 25.033605,
      "text": "به این می‌گن Passive Vocabulary."
    },
    {
      "start": 25.417143,
      "end": 31.638821,
      "text": "یعنی کلمه‌هایی که معنی‌شون رو متوجه می‌شی، اما نمی‌تونی به‌راحتی خودت به یادشون بیاری و استفاده‌شون کنی."
    },
    {
      "start": 32.064898,
      "end": 34.354717,
      "text": "در مقابل، Active Vocabulary قرار داره."
    },
    {
      "start": 34.746259,
      "end": 38.456009,
      "text": "یعنی کلمه‌هایی که می‌تونی توی مکالمه و نوشتنت ازشون استفاده کنی."
    },
    {
      "start": 38.868685,
      "end": 42.349524,
      "text": "حالا چطور کلمه‌ها رو وارد دایره‌ی لغات فعال خودمون کنیم؟"
    },
    {
      "start": 42.779773,
      "end": 44.096916,
      "text": "سه تا مرحله رو امتحان کن:"
    },
    {
      "start": 44.566961,
      "end": 46.29068,
      "text": "STEP ONE: CONTEXT."
    },
    {
      "start": 46.71483,
      "end": 49.237982,
      "text": "کلمه رو داخل یه موقعیت واقعی یاد بگیر."
    },
    {
      "start": 49.570023,
      "end": 52.998707,
      "text": "مثلاً فرض کن توی رستورانی و می‌خوای از گارسون پیشنهاد بگیری."
    },
    {
      "start": 53.398549,
      "end": 55.429478,
      "text": "RECOMMEND یعنی پیشنهاد دادن."
    },
    {
      "start": 55.870816,
      "end": 57.33195,
      "text": "STEP TWO: LISTEN."
    },
    {
      "start": 57.794853,
      "end": 60.304172,
      "text": "تلفظ و کاربردش رو توی یه جمله بشنو:"
    },
    {
      "start": 60.765714,
      "end": 61.868844,
      "text": "Can you recommend a dish?"
    },
    {
      "start": 62.305828,
      "end": 63.926077,
      "text": "STEP THREE: USE."
    },
    {
      "start": 64.338503,
      "end": 65.371111,
      "text": "حالا خودت جواب بده:"
    },
    {
      "start": 65.752154,
      "end": 66.85644,
      "text": "I'd recommend the pasta."
    },
    {
      "start": 67.219841,
      "end": 71.13161,
      "text": "دیدی؟ حالا می‌تونی از این کلمه توی یه مکالمه‌ی واقعی استفاده کنی!"
    },
    {
      "start": 71.533107,
      "end": 83.33102,
      "text": "برای همین ما توی رهنما هر هفته ۱۰ لغت کاربردی درباره‌ی یک موضوع مشخص و متناسب با سطح زبانت آماده می‌کنیم؛ همراه با مثال، فایل صوتی و ورک‌شیت تمرین و اسپیکینگ."
    },
    {
      "start": 83.73,
      "end": 90.070317,
      "text": "اگه می‌خوای بسته‌ی هفتگی ACTIVE VOCABULARY رو دریافت کنی، فقط کلمه‌ی ACTIVE رو کامنت کن تا برات بفرستیم!"
    },
    {
      "start": 90.485397,
      "end": 93.088458,
      "text": "Don't just memorize words. Learn to use them!"
    }
  ]
