  "groups": [
    {
      "start": 1.0,
      "end": 1.643718,
      "text": "تو هم وقتی"
    },
    {
      "start": 1.643718,
      "end": 2.337865,
      "text": "یه لغت جدید"
    },
    {
      "start": 2.337865,
      "end": 3.313612,
      "text": "انگلیسی یاد می‌گیری،"
    },
    {
      "start": 3.313612,
      "end": 4.180589,
      "text": "این سه تا"
    },
    {
      "start": 4.180589,
      "end": 4.597212,
      "text": "کار رو"
    },
    {
      "start": 4.597212,
      "end": 5.192018,
      "text": "انجام می‌دی؟"
    },
    {
      "start": 5.895034,
      "end": 6.81642,
      "text": "معنی فارسیش رو"
    },
    {
      "start": 6.81642,
      "end": 7.878617,
      "text": "توی دفترت می‌نویسی؟"
    },
    {
      "start": 8.517234,
      "end": 9.517692,
      "text": "تعریف انگلیسیش رو"
    },
    {
      "start": 9.517692,
      "end": 10.522812,
      "text": "از دیکشنری می‌خونی؟"
    },
    {
      "start": 11.070249,
      "end": 12.026337,
      "text": "مثال دیکشنری رو"
    },
    {
      "start": 12.026337,
      "end": 12.589911,
      "text": "هم کنارش"
    },
    {
      "start": 12.589911,
      "end": 13.384558,
      "text": "یادداشت می‌کنی؟"
    },
    {
      "start": 14.011179,
      "end": 14.95559,
      "text": "این کارها برای"
    },
    {
      "start": 14.95559,
      "end": 15.763768,
      "text": "شناختن معنی کلمه"
    },
    {
      "start": 15.763768,
      "end": 16.380919,
      "text": "خوبن، اما یه"
    },
    {
      "start": 16.380919,
      "end": 16.874399,
      "text": "مشکل دارن!"
    },
    {
      "start": 17.379048,
      "end": 18.422289,
      "text": "ممکنه معنی یه"
    },
    {
      "start": 18.422289,
      "end": 19.939066,
      "text": "کلمه رو بدونی،"
    },
    {
      "start": 19.939066,
      "end": 21.402709,
      "text": "ولی وقتی می‌خوای"
    },
    {
      "start": 21.402709,
      "end": 22.696052,
      "text": "صحبت کنی، نتونی"
    },
    {
      "start": 22.696052,
      "end": 23.843107,
      "text": "ازش استفاده کنی."
    },
    {
      "start": 24.329478,
      "end": 25.086148,
      "text": "به این می‌گن"
    },
    {
      "start": 25.086148,
      "end": 26.033605,
      "text": "Passive Vocabulary."
    },
    {
      "start": 26.417143,
      "end": 27.47473,
      "text": "یعنی کلمه‌هایی که"
    },
    {
      "start": 27.47473,
      "end": 28.541163,
      "text": "معنی‌شون رو متوجه"
    },
    {
      "start": 28.541163,
      "end": 29.620402,
      "text": "می‌شی، اما نمی‌تونی"
    },
    {
      "start": 29.620402,
      "end": 30.639121,
      "text": "به‌راحتی خودت به"
    },
    {
      "start": 30.639121,
      "end": 31.781444,
      "text": "یادشون بیاری و"
    },
    {
      "start": 31.781444,
      "end": 32.638821,
      "text": "استفاده‌شون کنی."
    },
    {
      "start": 33.064898,
      "end": 34.221071,
      "text": "در مقابل، Active"
    },
    {
      "start": 34.221071,
      "end": 35.354717,
      "text": "Vocabulary قرار داره."
    },
    {
      "start": 35.746259,
      "end": 36.756375,
      "text": "یعنی کلمه‌هایی که"
    },
    {
      "start": 36.756375,
      "end": 37.835468,
      "text": "می‌تونی توی مکالمه"
    },
    {
      "start": 37.835468,
      "end": 38.743313,
      "text": "و نوشتنت ازشون"
    },
    {
      "start": 38.743313,
      "end": 39.456009,
      "text": "استفاده کنی."
    },
    {
      "start": 39.868685,
      "end": 40.955963,
      "text": "حالا چطور کلمه‌ها"
    },
    {
      "start": 40.955963,
      "end": 41.930296,
      "text": "رو وارد دایره‌ی"
    },
    {
      "start": 41.930296,
      "end": 42.594196,
      "text": "لغات فعال"
    },
    {
      "start": 42.594196,
      "end": 43.349524,
      "text": "خودمون کنیم؟"
    },
    {
      "start": 43.779773,
      "end": 44.421135,
      "text": "سه تا مرحله"
    },
    {
      "start": 44.421135,
      "end": 45.096916,
      "text": "رو امتحان کن:"
    },
    {
      "start": 45.566961,
      "end": 47.29068,
      "text": "STEP ONE: CONTEXT."
    },
    {
      "start": 47.71483,
      "end": 48.600221,
      "text": "کلمه رو داخل"
    },
    {
      "start": 48.600221,
      "end": 49.624986,
      "text": "یه موقعیت واقعی"
    },
    {
      "start": 49.624986,
      "end": 50.237982,
      "text": "یاد بگیر."
    },
    {
      "start": 50.570023,
      "end": 51.30439,
      "text": "مثلاً فرض کن"
    },
    {
      "start": 51.30439,
      "end": 52.30964,
      "text": "توی رستورانی و"
    },
    {
      "start": 52.30964,
      "end": 53.252285,
      "text": "می‌خوای از گارسون"
    },
    {
      "start": 53.252285,
      "end": 53.998707,
      "text": "پیشنهاد بگیری."
    },
    {
      "start": 54.398549,
      "end": 55.460019,
      "text": "RECOMMEND یعنی"
    },
    {
      "start": 55.460019,
      "end": 56.429478,
      "text": "پیشنهاد دادن."
    },
    {
      "start": 56.870816,
      "end": 58.33195,
      "text": "STEP TWO: LISTEN."
    },
    {
      "start": 58.794853,
      "end": 59.811561,
      "text": "تلفظ و کاربردش"
    },
    {
      "start": 59.811561,
      "end": 60.586739,
      "text": "رو توی یه"
    },
    {
      "start": 60.586739,
      "end": 61.304172,
      "text": "جمله بشنو:"
    },
    {
      "start": 61.765714,
      "end": 62.535162,
      "text": "Can you recommend"
    },
    {
      "start": 62.535162,
      "end": 62.868844,
      "text": "a dish?"
    },
    {
      "start": 63.305828,
      "end": 64.926077,
      "text": "STEP THREE: USE."
    },
    {
      "start": 65.338503,
      "end": 65.876114,
      "text": "حالا خودت"
    },
    {
      "start": 65.876114,
      "end": 66.371111,
      "text": "جواب بده:"
    },
    {
      "start": 66.752154,
      "end": 67.343302,
      "text": "I'd recommend"
    },
    {
      "start": 67.343302,
      "end": 67.85644,
      "text": "the pasta."
    },
    {
      "start": 68.219841,
      "end": 68.528352,
      "text": "دیدی؟"
    },
    {
      "start": 68.528352,
      "end": 69.624818,
      "text": "حالا می‌تونی از"
    },
    {
      "start": 69.624818,
      "end": 70.452533,
      "text": "این کلمه توی"
    },
    {
      "start": 70.452533,
      "end": 71.440396,
      "text": "یه مکالمه‌ی واقعی"
    },
    {
      "start": 71.440396,
      "end": 72.13161,
      "text": "استفاده کنی!"
    },
    {
      "start": 72.533107,
      "end": 73.495432,
      "text": "برای همین ما"
    },
    {
      "start": 73.495432,
      "end": 74.661392,
      "text": "توی رهنما هر"
    },
    {
      "start": 74.661392,
      "end": 75.566358,
      "text": "هفته ۱۰ لغت"
    },
    {
      "start": 75.566358,
      "end": 76.817418,
      "text": "کاربردی درباره‌ی یک"
    },
    {
      "start": 76.817418,
      "end": 77.750358,
      "text": "موضوع مشخص و"
    },
    {
      "start": 77.750358,
      "end": 78.754975,
      "text": "متناسب با سطح"
    },
    {
      "start": 78.754975,
      "end": 80.043723,
      "text": "زبانت آماده می‌کنیم؛"
    },
    {
      "start": 80.043723,
      "end": 81.63178,
      "text": "همراه با مثال،"
    },
    {
      "start": 81.63178,
      "end": 82.750028,
      "text": "فایل صوتی و"
    },
    {
      "start": 82.750028,
      "end": 83.625132,
      "text": "ورک‌شیت تمرین"
    },
    {
      "start": 83.625132,
      "end": 84.33102,
      "text": "و اسپیکینگ."
    },
    {
      "start": 84.73,
      "end": 85.819634,
      "text": "اگه می‌خوای بسته‌ی"
    },
    {
      "start": 85.819634,
      "end": 87.207198,
      "text": "هفتگی ACTIVE VOCABULARY"
    },
    {
      "start": 87.207198,
      "end": 88.13523,
      "text": "رو دریافت کنی،"
    },
    {
      "start": 88.13523,
      "end": 89.224864,
      "text": "فقط کلمه‌ی ACTIVE"
    },
    {
      "start": 89.224864,
      "end": 90.047991,
      "text": "رو کامنت کن"
    },
    {
      "start": 90.047991,
      "end": 91.070317,
      "text": "تا برات بفرستیم!"
    },
    {
      "start": 91.485397,
      "end": 92.065424,
      "text": "Don't just"
    },
    {
      "start": 92.065424,
      "end": 92.836565,
      "text": "memorize words."
    },
    {
      "start": 92.836565,
      "end": 93.554407,
      "text": "Learn to"
    },
    {
      "start": 93.554407,
      "end": 94.088458,
      "text": "use them!"
    }
  ]
}